{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rjaa-tokyo",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rjaa-tokyo-site","database_id": "395c51c4-f6d1-4e28-9ca9-4c83098406a2",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "rjaa-tokyo-media","preview_bucket_name": "rjaa-tokyo-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
